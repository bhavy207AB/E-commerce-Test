# Copy to utils/.env (gitignored) and fill in. playwright.config.ts loads this file.

# Required. Project API key from TestDino -> Project settings.
TESTDINO_TOKEN=

# Optional. Defaults to https://reporter.testdino.com/ - override for staging.
TESTDINO_SERVER_URL=

# Optional. App under test.
BASE_URL=https://storedemo.testdino.com/products

# Optional. Comma-separated run-level tags, and reporter debug logging.
TESTDINO_TAGS=
TESTDINO_DEBUG=false
